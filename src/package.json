{
  "name": "aptabase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"import('fs').then(fs => { const m = fs.readFileSync('./webapp/version.ts', 'utf8').match(/APP_VERSION\\s*=\\s*\\\"([^\\\"]+)\\\"/); fs.writeFileSync('./webapp/public/version.json', JSON.stringify({ version: m ? m[1] : 'v2.0.7' })); });\" && tsc && vite build",
    "dev": "vite --clearScreen false",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@aptabase/web": "^0.5.0",
    "@datepicker-suggest/react": "0.0.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource/inter": "^5.3.0",
    "@headlessui/react": "^2.2.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tabler/icons-react": "~2.47.0",
    "@tanstack/react-query": "5.0.0",
    "cal-sans": "1.0.1",
    "chart.js": "~4.4.8",
    "chartjs-plugin-annotation": "3.0.1",
    "cmdk": "0.2.1",
    "date-fns": "3.6.0",
    "framer-motion": "10.16.4",
    "immer": "^10.1.1",
    "jotai": "~2.12.1",
    "jotai-location": "^0.5.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "9.0.0",
    "react-router-dom": "~6.28.2",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "7.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "1.0.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "20.8.7",
    "@types/react": "18.2.30",
    "@types/react-dom": "18.2.14",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.6.0",
    "postcss": "^8.5.0",
    "tailwind-merge": "1.14.0",
    "tailwindcss": "~3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.2.2",
    "vite": "^8.3.0",
    "vite-plugin-mkcert": "^1.17.5",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=14",
    "npm": ">=7"
  },
  "prettier": {
    "printWidth": 120
  }
}
