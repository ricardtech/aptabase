SELECT session_id as Id,	
       min(min_timestamp) as StartedAt,
       max(max_timestamp) - min(min_timestamp) as Duration,
       countMerge(events_count) as EventsCount,
       argMaxMerge(app_version) as AppVersion,
       argMaxMerge(country_code) as CountryCode,
       argMaxMerge(region_name) as RegionName,
       argMaxMerge(os_name) as OsName,
       argMaxMerge(os_version) as OsVersion
FROM sessions_live_v1
WHERE app_id = '{{app_id}}'
{% if country_code %}
AND country_code = '{{country_code}}'
{% endif %}
{% if os_name %}
AND os_name = '{{os_name}}'
{% endif %}
{% if app_version %}
AND app_version = '{{app_version}}'
{% endif %}
{% if date_to %}
AND (max_timestamp < '{{date_to}}' OR (max_timestamp = '{{date_to}}' AND session_id < '{{session_id}}'))
{% endif %}
{% if date_from %}
AND (max_timestamp > '{{date_from}}' OR (max_timestamp = '{{date_from}}' AND session_id > '{{session_id}}'))
{% endif %}
GROUP BY session_id
{% if event_name %}
HAVING hasAny(groupArrayMerge(events_name), ['{{event_name}}'])
{% endif %}
{% if date_from %}
ORDER BY max(max_timestamp) ASC, Id ASC
{% else %}
ORDER BY max(max_timestamp) DESC, Id DESC
{% endif %}
LIMIT 10