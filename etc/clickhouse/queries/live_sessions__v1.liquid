SELECT session_id as Id,	
       min(min_timestamp) as StartedAt,
       max(max_timestamp) - min(min_timestamp) as Duration,
       countMerge(events_count) as EventsCount,
       argMaxMerge(app_version) as AppVersion,
       argMaxMerge(country_code) as CountryCode,
       argMaxMerge(region_name) as RegionName,
       argMaxMerge(os_name) as OsName,
       argMaxMerge(os_version) as OsVersion
FROM sessions_live_v1
WHERE app_id = '{{app_id}}'
GROUP BY session_id
HAVING max(max_timestamp) >= now() - INTERVAL 2 HOUR
ORDER BY max(max_timestamp) DESC
LIMIT 12